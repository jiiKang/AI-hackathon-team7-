# 이 파일을 .env 로 복사해서 쓰세요 (cp .env.example .env)
# .env 는 절대 git에 올리지 마세요 (.gitignore에 이미 포함)

# ★ [공란] LLM API 키 — Google AI Studio(Gemini)에서 무료로 발급
#   비워 두면 키워드 매칭 모드로 동작해요 (데모/개발용)
GEMINI_API_KEY=

# ★ [확인 필요] 무료 티어에서 쓸 수 있는 모델명 (바뀔 수 있어요)
GEMINI_MODEL=gemini-3.5-flash

# 카페 데이터 파일 경로 (기본: data/cafes.json)
# 샘플로 먼저 체험하려면 아래 줄 주석 해제
# CAFES_PATH=data/cafes.sample.json

# 서버 주소 (폰으로 접속하려면 HOST=0.0.0.0)
# HOST=127.0.0.1
# PORT=8000

# ★ [공란] 카카오 JavaScript 키 — 지도 표시에 필수
#   카카오 개발자 콘솔 > 내 애플리케이션 > 앱 키 > JavaScript 키
#   같은 콘솔에서 두 가지도 꼭 설정:
#    (1) 제품 설정 > 카카오맵 > 사용 설정 ON
#    (2) 앱 > 플랫폼 키(또는 플랫폼) > JavaScript SDK 도메인에
#        http://127.0.0.1:8000 과 http://localhost:8000 등록
KAKAO_JS_KEY=

# ★ [공란] 카카오 REST API 키 — 상호명으로 좌표를 자동 조회 (JavaScript 키와 다른 키!)
#   카카오 개발자 콘솔 > 내 애플리케이션 > 앱 키 > REST API 키
#   채워 두면 data/cafes.json 에 위도/경도를 안 적어도 돼요. 조회 결과는 data/geocode_cache.json 에 저장돼요.
KAKAO_REST_KEY=

# (선택) LLM 사용 방식
#   translate(기본): LLM은 질문을 '검색 조건'으로 번역만 하고, 데이터 매칭은 코드가 해요. 빠름(1~3초 기대)
#   rank: LLM이 카페 데이터 전체를 보고 순위를 정해요. 느리지만 문장 이유가 자연스러워요
LLM_MODE=translate

# (선택) 정보 수정 제안을 받을 구글 Apps Script 웹훅 주소
FEEDBACK_WEBHOOK_URL=
